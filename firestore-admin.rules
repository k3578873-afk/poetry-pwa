rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /poems/{poemId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "GgKTFgrTyKUUtxZwL8QEy4BlCRs1";
    }
    match /{document=**} { allow read, write: if false; }
  }
}
